{
  "name": "msg-stream",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "vite preview",
    "lint": "eslint",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
